---
import Icon from './Icon.astro';
import Team from './Team.astro';
import { technologies } from '../data/site';
import { asset } from '../lib/assets';
interface Props {
  headingLevel?: 'h1' | 'h2';
  showLink?: boolean;
}
const { headingLevel = 'h2', showLink = true } = Astro.props;
const H = headingLevel;
const simbolo = asset('simbolo-3d.webp');
const commitments = [
  { name: 'Lenguaje claro', text: 'Te explicamos cada decisión sin tecnicismos, para que decidas con información.' },
  { name: 'Avances que puedes ver', text: 'Trabajamos por etapas y te mostramos el software funcionando, no solo informes.' },
  { name: 'Datos protegidos', text: 'La seguridad y la privacidad se diseñan desde el inicio, no se agregan al final.' },
];
---
<section class="sec abt" id="equipo" aria-labelledby="abt-titulo">
  <div class="wrap">
    <div class="sec__head">
      <H id="abt-titulo" class="display sec__title">Quiénes<br />somos.</H>
      <p class="sec__lead">Un equipo con un mismo cuidado por tu proyecto. Hablas directamente con quienes lo diseñan y lo construyen.</p>
    </div>
    <Team />
    <div class="abt__grid">
      <div class="abt__wrapcard">
      <div class="abt__card hoja">
        {simbolo && <img class="abt__img" src={simbolo} alt="" width="800" height="800" loading="lazy" />}
        <p class="abt__intro">Vertika Platforms es una agencia de desarrollo de software con sede en Perú. Diseñamos y construimos software a medida para personas, empresas y organizaciones de salud, con un proceso claro de principio a fin.</p>
        {showLink && <a class="link-arrow" href="/nosotros/">Más sobre nosotros <Icon name="arrow" /></a>}
      </div>
      </div>
      <ul class="abt__commit">
        {commitments.map((c) => (
          <li>
            <h3><span class="knot" aria-hidden="true"></span>{c.name}</h3>
            <p>{c.text}</p>
          </li>
        ))}
      </ul>
    </div>

    <div class="abt__tech">
      <h3 class="abt__sub">Tecnologías con las que trabajamos</h3>
      <dl>
        {technologies.map((t) => (
          <div>
            <dt>{t.group}</dt>
            <dd>{t.items.join(' · ')}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .abt__grid {
    margin-top: clamp(3.5rem, 7vw, 5rem);
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .abt__wrapcard {
    position: relative;
  }
  .abt__card {
    position: relative;
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    padding-right: clamp(1.5rem, 30%, 16rem);
    min-height: 16rem;
    overflow: hidden;
  }
  .abt__img {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    width: min(26%, 12rem);
    pointer-events: none;
  }
  .abt__intro {
    font-size: var(--step-2);
    line-height: 1.35;
    letter-spacing: -0.015em;
  }
  .abt__commit {
    display: grid;
    gap: 1.6rem;
    margin: 0;
    padding: 0.5rem 0 0;
    list-style: none;
  }
  .abt__commit h3 {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 1.2rem;
    margin-bottom: 0.3rem;
  }
  .abt__commit .knot {
    background: var(--azul);
  }
  .abt__commit p {
    color: var(--tinta-2);
    padding-left: 1.4rem;
  }
  .abt__sub {
    font-size: 1.1rem;
    margin-bottom: 1.25rem;
  }
  .abt__team {
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }
  .abt__team ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .abt__member {
    padding: 1rem;
  }
  .abt__member img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 3px;
    margin-bottom: 1rem;
  }
  .abt__name {
    font-weight: 700;
    font-size: 1.15rem;
  }
  .abt__role {
    color: var(--azul);
    font-weight: 500;
    margin-bottom: 0.5rem;
  }
  .abt__tech {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--linea);
  }
  .abt__tech dl {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem 2rem;
    margin: 0;
  }
  .abt__tech dt {
    font-weight: 700;
    margin-bottom: 0.3rem;
  }
  .abt__tech dd {
    margin: 0;
    color: var(--tinta-2);
  }
  @media (max-width: 900px) {
    .abt__grid {
      grid-template-columns: 1fr;
    }
    .abt__tech dl {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .abt__card {
      padding-right: 1.5rem;
      padding-bottom: 9rem;
    }
    .abt__img {
      width: 10rem;
    }
  }
</style>
