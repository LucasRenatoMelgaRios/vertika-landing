---
import Icon, { type IconName } from './Icon.astro';
import MiniUI from './MiniUI.astro';
import { audiences, type Audience, type Mini } from '../data/site';

interface Props {
  only: Audience;
  /** show only services of this group (e.g. 'medida' on /empresas/) */
  group?: 'producto' | 'medida';
  title?: string;
  lead?: string;
}
const { only, group, title, lead } = Astro.props;
const icons: Record<Mini, IconName> = {
  web: 'globe', app: 'phone', proto: 'pen', auto: 'refresh', tabla: 'table', insumos: 'table', crm: 'user', erp: 'layers', api: 'plug',
  portal: 'doc', panel: 'chart', agenda: 'calendar', roles: 'key', paciente: 'user',
};
const cards = only.services.filter((s) => !group || s.group === group);
// Wide cards: from the data when given, otherwise so every row is full (dense flow).
const wideAt: Record<number, number[]> = { 4: [0, 3], 5: [0], 7: [0, 4], 8: [0, 7] };
const hasWide = cards.some((c) => c.wide);
const wide = hasWide ? cards.map((c, i) => (c.wide ? i : -1)).filter((i) => i >= 0) : (wideAt[cards.length] ?? []);
---
<section class="sec bento" id="soluciones" aria-labelledby="bento-titulo">
  <div class="wrap">
    <div class="sec__head bento__head">
      <h2 id="bento-titulo" class="display sec__title">
        {title ? <Fragment set:html={title} /> : <>Lo que construimos<br />para {only.label.toLowerCase()}.</>}
      </h2>
      <p class="sec__lead">{lead ?? only.intro}</p>
    </div>
    <ul class="bento__grid">
      {cards.map((c, i) => (
        <li class:list={['bento__card hoja', { wide: wide.includes(i) }]} id={c.anchor} data-reveal style={`transition-delay:${(i % 3) * 70}ms`}>
          <div class="bento__top">
            <span class="tile"><Icon name={icons[c.mini]} /></span>
          </div>
          <h3>{c.name}</h3>
          <p>{c.text}</p>
          <MiniUI kind={c.mini} />
          {c.href && !c.href.includes('#') && <a class="bento__more" href={c.href}>Conocer {c.name.toLowerCase()} <Icon name="arrow" /></a>}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .bento__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bento__head {
    position: relative;
  }
  .bento__card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.4rem;
  }
  .bento__card.wide {
    grid-column: span 2;
  }
  .bento__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.1rem;
  }
  .bento__aud {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tinta-3);
    text-decoration: none;
  }
  .bento__aud:hover {
    color: var(--azul);
  }
  .bento__card[id] {
    scroll-margin-top: 6rem;
  }
  .bento__more {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.1rem;
    font-weight: 700;
    text-decoration: none;
  }
  .bento__more :global(.icon) {
    width: 1rem;
    height: 1rem;
    transition: transform 0.3s var(--ease-out);
  }
  .bento__more:hover :global(.icon) {
    transform: translateX(3px);
  }
  .bento__card h3 {
    font-size: 1.2rem;
    letter-spacing: -0.01em;
    margin-bottom: 0.4rem;
  }
  .bento__card p {
    color: var(--tinta-2);
    font-size: 0.975rem;
  }
  .bento__card :global(.mini) {
    margin-top: auto;
  }
  .bento__card > p {
    margin-bottom: 1.1rem;
  }
  @media (max-width: 1000px) {
    .bento__grid {
      grid-template-columns: 1fr 1fr;
    }
    .bento__card.wide {
      grid-column: span 2;
    }
  }
  @media (max-width: 640px) {
    .bento__grid {
      grid-template-columns: 1fr;
    }
    .bento__card.wide {
      grid-column: auto;
    }
  }
</style>
