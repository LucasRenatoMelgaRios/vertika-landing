---
/**
 * Ideas by business type, masonry like a showcase wall. No testimonials (there are none yet):
 * text cards say what each kind of project includes. Sites shown are illustrative mockups.
 */
import Icon from './Icon.astro';
type Card =
  | { kind: 'site'; chip: string; photo: string; alt: string; pos?: string; brand: string; line: string; h: 'a' | 'b' | 'c' }
  | { kind: 'note'; title: string; items: string[]; icon: 'check' };
const cols: Card[][] = [
  [
    { kind: 'site', chip: 'Tienda de ropa', photo: '/fotos/boutique.webp', alt: 'Boutique con ropa colgada', brand: 'ÁNIMA', line: 'Ropa hecha en Lima', h: 'a' },
    { kind: 'note', title: 'Una tienda online incluye', items: ['Catálogo que tú actualizas', 'Pagos con tarjeta, Yape o Plin', 'Avisos de pedido por WhatsApp'], icon: 'check' },
  ],
  [
    { kind: 'site', chip: 'Consultorio', photo: '/fotos/consulta.webp', alt: 'Médico atendiendo a un paciente', pos: '45% 30%', brand: 'Clínica Santa Rosa', line: 'Reserva tu cita en línea', h: 'b' },
    { kind: 'site', chip: 'Panadería', photo: '/fotos/panaderia.webp', alt: 'Mostrador de una panadería con pan artesanal', brand: 'Horno de Barrio', line: 'Pedidos para recoger', h: 'c' },
  ],
  [
    { kind: 'note', title: 'Un sistema para tu empresa incluye', items: ['Usuarios con permisos por rol', 'Conexión con tu facturación', 'Reportes que llegan solos'], icon: 'check' },
    { kind: 'site', chip: 'Estudio de yoga', photo: '/fotos/yoga.webp', alt: 'Clase de yoga en un estudio luminoso', pos: '72% 55%', brand: 'Estudio Prana', line: 'Reserva tu clase', h: 'b' },
  ],
  [
    { kind: 'site', chip: 'Cafetería y pastelería', photo: '/fotos/vitrina.webp', alt: 'Vitrina de una pastelería con postres', brand: 'Dulce Miraflores', line: 'Carta y delivery', h: 'c' },
    { kind: 'site', chip: 'Distribuidora', photo: '/fotos/equipo.webp', alt: 'Equipo de una empresa trabajando con laptops', pos: '50% 30%', brand: 'Comercial Andina', line: 'Portal de clientes', h: 'a' },
  ],
];
---
<section class="sec gal" id="ideas" aria-labelledby="gal-titulo">
  <div class="wrap">
    <div class="sec__head gal__head">
      <h2 id="gal-titulo" class="display sec__title">Ideas de lo que<br />podemos construir.</h2>
      <p class="sec__lead">Webs, tiendas, reservas y sistemas para todo tipo de negocio. La tuya podría ser la siguiente.</p>
      <a class="btn btn--ink" href="#arma">Cuéntanos tu idea <Icon name="arrow" /></a>
    </div>
    <div class="gal__wall">
      {cols.map((col, ci) => (
        <div class="gal__col" style={`--off:${[0, 3, 1.5, 4][ci]}rem`}>
          {col.map((c) =>
            c.kind === 'site' ? (
              <figure class:list={['gal__site', `gal__site--${c.h}`]} data-reveal>
                <img src={c.photo} alt={c.alt} width="960" height="640" loading="lazy" decoding="async" style={c.pos ? `object-position:${c.pos}` : undefined} />
                <span class="gal__chip">{c.chip}</span>
                <figcaption class="gal__mock">
                  <span class="gal__mock-bar"><i></i><i></i><i></i></span>
                  <b>{c.brand}</b>
                  <span>{c.line}</span>
                  <span class="gal__mock-btn">Ver más</span>
                </figcaption>
              </figure>
            ) : (
              <div class="gal__note hoja" data-reveal>
                <p class="gal__note-title">{c.title}</p>
                <ul>
                  {c.items.map((t) => <li><Icon name={c.icon} />{t}</li>)}
                </ul>
              </div>
            ),
          )}
        </div>
      ))}
    </div>
    <p class="gal__fine">Ejemplos ilustrativos con marcas ficticias y fotografías de stock.</p>
  </div>
</section>

<style>
  .gal__head {
    justify-items: start;
  }
  .gal__head .btn {
    margin-left: 1.6rem;
  }
  .gal__wall {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
    align-items: start;
  }
  .gal__col {
    display: grid;
    gap: 0.9rem;
    margin-top: var(--off);
  }
  .gal__site {
    position: relative;
    margin: 0;
    border-radius: 14px;
    overflow: hidden;
    background: var(--noche);
    box-shadow: var(--shadow);
  }
  .gal__site img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }
  .gal__site--a {
    aspect-ratio: 3 / 4;
  }
  .gal__site--b {
    aspect-ratio: 4 / 5;
  }
  .gal__site--c {
    aspect-ratio: 1;
  }
  .gal__site:hover img {
    transform: scale(1.015);
  }
  .gal__chip {
    position: absolute;
    top: 0.8rem;
    left: 0.8rem;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: rgba(11, 27, 77, 0.88);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
  }
  .gal__mock {
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: 0.8rem;
    display: grid;
    gap: 0.2rem;
    padding: 0.7rem 0.8rem 0.8rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.95);
    color: var(--tinta);
    box-shadow: 0 14px 30px -16px rgba(11, 27, 77, 0.6);
    transform: translateY(0.4rem);
    transition: transform 0.5s var(--ease-out);
  }
  .gal__site:hover .gal__mock {
    transform: none;
  }
  .gal__mock-bar {
    display: flex;
    gap: 0.25rem;
    margin-bottom: 0.25rem;
  }
  .gal__mock-bar i {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--linea);
  }
  .gal__mock b {
    font-family: var(--display);
    font-weight: 850;
    font-stretch: 110%;
    font-size: 1rem;
    text-transform: uppercase;
    line-height: 1.1;
  }
  .gal__mock span:not(.gal__mock-bar):not(.gal__mock-btn) {
    font-size: 0.8rem;
    color: var(--tinta-2);
  }
  .gal__mock-btn {
    justify-self: start;
    margin-top: 0.35rem;
    padding: 0.25rem 0.6rem;
    border-radius: 3px;
    background: var(--azul);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
  }
  .gal__note {
    padding: 1.4rem;
    border-radius: 14px;
  }
  .gal__note-title {
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 0.9rem;
  }
  .gal__note ul {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .gal__note li {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
    color: var(--tinta-2);
    font-size: 0.95rem;
  }
  .gal__note li :global(.icon) {
    width: 1rem;
    height: 1rem;
    margin-top: 0.25rem;
    color: var(--turquesa-tinta);
    stroke-width: 2.4;
  }
  .gal__fine {
    margin-top: 1.25rem;
    font-size: 0.8125rem;
    color: var(--tinta-2);
  }
  @media (max-width: 1000px) {
    .gal__wall {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .gal__col {
      margin-top: 0;
    }
  }
  @media (max-width: 560px) {
    .gal__wall {
      grid-template-columns: 1fr;
    }
    .gal__head .btn {
      margin-left: 0;
    }
  }
</style>
