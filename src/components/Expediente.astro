---
import Icon from './Icon.astro';
import type { Audience } from '../data/site';
interface Props {
  a: Audience;
  hidden?: boolean;
  dataAud?: boolean;
}
const { a, hidden = false, dataAud = false } = Astro.props;
const e = a.expediente;
---
<figure class="exp" data-aud={dataAud ? a.id : undefined} hidden={hidden}>
  <div class="exp__sheet hoja">
    <div class="exp__bar mono">
      <span><span class="exp__prompt">&gt;_</span> vertika · expediente</span>
      <span class="exp__live"><span class="exp__dot"></span>{a.id === 'personas' ? 'producto propio · en línea' : 'ejemplo ilustrativo'}</span>
    </div>
    <div class="exp__body mono">
      <p class="exp__line"><span class="exp__k">proyecto</span> {e.proyecto}</p>
      <ol>
        {e.pasos.map(([ok, t], i) => (
          <li class:list={['exp__step', { 'is-next': !ok }]} style={`--d:${i}`}>
            {ok ? <Icon name="check" /> : <span class="exp__caret">&gt;</span>}
            <span>{t}</span>
          </li>
        ))}
      </ol>
      <dl class="exp__rows">
        {e.filas.map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
  <figcaption class="exp__note" aria-hidden="true">
    <span>Todo por escrito</span>
    <svg viewBox="0 0 220 18" preserveAspectRatio="none"><path d="M3 12 C 40 4, 90 15, 130 8 S 200 6, 217 11" /></svg>
  </figcaption>
</figure>

<style>
  .exp {
    position: relative;
    margin: 0;
  }
  .exp__sheet {
    position: relative;
    padding: 0 2.1rem;
    overflow: hidden;
  }
  /* Perforated tractor-feed edges */
  .exp__sheet::before,
  .exp__sheet::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1.35rem;
    background-image: radial-gradient(circle at center, var(--linea) 0 3.5px, transparent 4px);
    background-size: 100% 22px;
    border-color: var(--linea-2);
    border-style: dashed;
  }
  .exp__sheet::before {
    left: 0;
    border-width: 0 1px 0 0;
  }
  .exp__sheet::after {
    right: 0;
    border-width: 0 0 0 1px;
  }
  .exp__bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0.5rem;
    border-bottom: 1px solid var(--linea);
    color: var(--tinta-2);
    font-size: 0.8125rem;
  }
  .exp__prompt {
    color: var(--azul);
    font-weight: 500;
  }
  .exp__live {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .exp__dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--turquesa);
    box-shadow: 0 0 0 3px var(--turquesa-suave);
  }
  .exp__body {
    padding: 1.15rem 0.5rem 1.1rem;
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .exp__line {
    margin-bottom: 0.6rem;
    color: var(--tinta);
  }
  .exp__k {
    color: var(--azul);
    margin-right: 0.5rem;
  }
  .exp__body ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.35rem;
  }
  .exp__step {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    color: var(--tinta);
  }
  .exp__step :global(.icon) {
    width: 0.95rem;
    height: 0.95rem;
    color: var(--turquesa);
    transform: translateY(0.15rem);
    stroke-width: 2.4;
  }
  .exp__caret {
    width: 0.95rem;
    color: var(--azul);
    font-weight: 500;
  }
  .exp__step.is-next {
    color: var(--azul);
    font-weight: 500;
  }
  .exp__step.is-next span:last-child::after {
    content: '';
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 0.3em;
    vertical-align: -0.15em;
    background: var(--azul);
    animation: blink 1.1s steps(2, start) infinite;
  }
  @keyframes blink {
    to {
      visibility: hidden;
    }
  }
  .exp__rows {
    margin: 1rem 0 0;
    padding-top: 0.85rem;
    border-top: 1px dashed var(--linea);
    display: grid;
    gap: 0.25rem;
  }
  .exp__rows div {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .exp__rows dt {
    color: var(--tinta-2);
  }
  .exp__rows div::after {
    content: '';
    order: 1;
    flex: 1;
    border-bottom: 1px dotted var(--tinta-3);
    transform: translateY(-0.25rem);
  }
  .exp__rows dd {
    order: 2;
    margin: 0;
    color: var(--tinta);
    font-weight: 500;
  }
  .exp__note {
    position: absolute;
    right: 0.5rem;
    bottom: -2.1rem;
    display: grid;
    justify-items: end;
    color: var(--azul);
    font-family: var(--display);
    font-weight: 800;
    font-stretch: 100%;
    font-size: 1.05rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    transform: rotate(-3deg) skewX(-9deg);
  }
  .exp__note svg {
    width: 11rem;
    height: 0.9rem;
    margin-top: -0.1rem;
    fill: none;
    stroke: var(--azul);
    stroke-width: 2.2;
    stroke-linecap: round;
  }
  .js .exp:not([hidden]) .exp__step {
    animation: line-in 0.5s var(--ease-out) both;
    animation-delay: calc(var(--d) * 90ms + 120ms);
  }
  @keyframes line-in {
    from {
      opacity: 0.001;
      transform: translateX(-6px);
    }
  }
  @media (max-width: 560px) {
    .exp__sheet {
      padding: 0 1.4rem;
    }
    .exp__sheet::before,
    .exp__sheet::after {
      width: 0.9rem;
      background-size: 100% 18px;
    }
    .exp__body {
      font-size: 0.8125rem;
    }
    .exp__live {
      display: none;
    }
  }
</style>
